    "motion": [
      "direct model API; no upstream ComfyNode schemas",
      "lazy ComfyUI imports",
      "keyword diffusion-model calls",
      "restore original sampler options if prepare raises",
      "batch scalar readbacks without altering reductions, scalar arithmetic or reuse thresholds"
    ],
    "spectrum": [
      "direct measured-preset API",
      "compatibility stack scoped to our runtime classes and initialized when applied",
      "exclude public nodes and objective-media modules",
      "isolated worker uses pack-specific namespace"
    ]
  }
